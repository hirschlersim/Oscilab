/* style.qss */

/* Global window backgrounds and text */
QWidget {
    background-color: #1e1e1e;
    color: #aaaaaa;
    font-family: "Segoe UI", sans-serif;
    font-size: 9pt;  /* pt, not px: a px-only font-size leaves QFont::pointSize() at -1,
                         which crashes any Qt/pyqtgraph code doing relative point-size math */
}

/* Sidebar and control groupings */
QGroupBox {
    font-weight: bold;
    border: 2px solid #333333;
    border-radius: 6px;
    margin-top: 12px;
    padding-top: 16px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 3px 0 3px;
}

/* Buttons */
QPushButton {
    background-color: #007acc;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    padding: 6px 12px;
    min-width: 60px;
}

QPushButton:hover {
    background-color: #0098ff;
}

QPushButton:pressed {
    background-color: #005a9e;
}

/* A checkable button that's on (the trigger's slope, Equal Axes): pressed in */
QPushButton:checked {
    background-color: #00457a;
    border: 1px solid #9fd0ff;
}

/* The toolbar's buttons: a toggle that's on (Downsampled, Stopped, Save
   Stream, Trigger, your @toggle controls) pressed in, like a button above.
   The same border either way, transparent when off, so nothing shifts. */
QToolBar QToolButton {
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 2px 4px;
}

QToolBar QToolButton:hover {
    background-color: #2d2d2d;
}

QToolBar QToolButton:checked {
    background-color: #00457a;
    border: 1px solid #9fd0ff;
    color: #ffffff;
}

/* Disabled state — without this, disabled widgets look identical to enabled
   ones, since the explicit colors above override Qt's native dimming.
   Covers e.g. Auto-locked Min/Max spinboxes and derived-signal buttons. */
QPushButton:disabled {
    background-color: #3a3a3a;
    color: #777777;
}

QDoubleSpinBox:disabled,
QSpinBox:disabled {
    background-color: #171717;
    color: #555555;
}

QRadioButton:disabled,
QCheckBox:disabled {
    color: #555555;
}

/* Menu bar (File/View/Math/Help) */
QMenuBar {
    background-color: #202f46;
    color: #ffffff;
    border-bottom: 1px solid #007acc;
}

QMenuBar::item {
    background: transparent;
    padding: 4px 10px;
}

QMenuBar::item:selected {
    background-color: #007acc;
}

QMenu {
    background-color: #202f46;
    color: #ffffff;
    border: 1px solid #007acc;
}

QMenu::item:selected {
    background-color: #007acc;
}

/* Without this, disabled entries (a running producer's Start, View > Reset
   View while running) look enabled: the explicit color above overrides Qt's
   native dimming. */
QMenu::item:disabled {
    color: #7a8699;
}

/* Status Bar styling */
QStatusBar {
    background-color: #202f46;
    border-top: 1px solid #007acc;
    color: #ffffff;
}

/* Without this, native styles (e.g. windows11) draw a sunken frame around
   each status bar item, which reads as a stray black box around the text. */
QStatusBar::item {
    border: none;
}

/* Permanent widgets (e.g. the "Load [%]:" label) are plain QWidgets, so
   without this they'd fall back to QWidget's #1e1e1e background above —
   a solid near-black box sitting on the status bar's navy. */
QStatusBar QLabel {
    background: transparent;
}

QProgressBar {
    border: 1px solid #333333;
    border-radius: 4px;
    background-color: #1e1e1e;
    color: #ffffff;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #007acc;
    border-radius: 3px;
}


